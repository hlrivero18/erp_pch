generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(50)
  password  String   @db.VarChar(250)
  name      String   @db.VarChar(10)
  lastName  String   @db.VarChar(10)
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  menuItemsCreated MenuItem[] @relation("creado_por")
  menuItemsUpdated MenuItem[] @relation("modificado_por")

  pedidoCreated Pedido[] @relation("pedido_creado_por")
  pedidoUpdated Pedido[] @relation("pedido_modificado_por")

  pedidoItemCreated PedidoItem[] @relation("item_p_creado_por")
  pedidoItemUpdated PedidoItem[] @relation("item_p_modificado_por")
}

model MenuItem {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(50)
  description   String?   @db.Text
  price         Decimal?  @db.Decimal(10,2)
  isAvailable   Boolean   @default(true)
  countSelect   Int       @default(0)
  createdBy     User      @relation(name:"creado_por", fields: [createdById], references: [id])
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedBy     User?     @relation(name: "modificado_por", fields: [updatedById], references: [id])
  updatedById   String?   @db.Uuid
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  pedidoItem PedidoItem[] @relation("referencia_a")
}

model Pedido {
  id            Int       @id @default(autoincrement())
  descripcion   String?   @db.Text
  total         Decimal?  @db.Decimal(10,2)
  subTotal      Decimal?  @db.Decimal(10,2)
  envio         Decimal?  @db.Decimal(10,2) @default(0)
  descuento     Int       @default(0)
  estado        String    @default("Pendiente") @db.VarChar(50)
  metodoPago    String    @default("Transferencia") @db.VarChar(50)

  createdBy     User      @relation(name:"pedido_creado_por", fields: [createdById], references: [id])
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedBy     User?     @relation(name: "pedido_modificado_por", fields: [updatedById], references: [id])
  updatedById   String?   @db.Uuid
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  pedidoItems PedidoItem[] @relation("pertenece_a")
}

model PedidoItem {
  id            Int       @id @default(autoincrement())
  fk_pedido     Pedido    @relation(name:"pertenece_a", fields:[fk_pedidoId], references:[id])
  fk_pedidoId   Int       
  fk_menuItem   MenuItem  @relation(name:"referencia_a", fields:[fk_menuItemId], references:[id])
  fk_menuItemId Int       
  name          String    @db.VarChar(50)
  descripcion   String?   @db.Text
  cantidad      Int       @default(1)

  precio        Decimal?  @db.Decimal(10,2)
  subPrecio     Decimal?  @db.Decimal(10,2)

  createdBy     User      @relation(name:"item_p_creado_por", fields: [createdById], references: [id])
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedBy     User?     @relation(name: "item_p_modificado_por", fields: [updatedById], references: [id])
  updatedById   String?   @db.Uuid
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  
  @@unique([fk_pedidoId, fk_menuItemId])
}